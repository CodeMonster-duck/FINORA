APP_NAME=FINORA API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./finora.db

# Generate a strong secret before setting APP_ENV=production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-64-char-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Explicit allowed origins (must be https:// in production; wildcards forbidden)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production hardening flags
REQUIRE_HTTPS=false
AUTO_SEED_DEMO=false
ENABLE_DEMO_LOGIN=false
RATE_LIMIT_LOGIN_PER_MIN=15
RATE_LIMIT_REGISTER_PER_MIN=10
